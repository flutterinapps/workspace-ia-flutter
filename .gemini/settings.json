{
  "context": {
    "fileName": [
      "GEMINI.md"
    ]
  },
  "mcpServers": {
    "dart": {
      "command": "dart",
      "args": [
        "mcp-server",
        "--enable=run_tests,dart_format,dart_fix,launch_app,list_devices,list_running_apps,get_app_logs,stop_app"
      ]
    },
    "figma": {
      "httpUrl": "https://mcp.figma.com/mcp"
    },
    "stitch": {
      "httpUrl": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "$STITCH_API_KEY"
      }
    },
    "marionette": {
      "command": "dart",
      "args": [
        "pub",
        "global",
        "run",
        "marionette_mcp"
      ]
    },
    "flutter-radar": {
      "command": "uv",
      "args": [
        "run",
        "-q",
        "tool/flutter_radar/radar.py",
        "serve"
      ]
    },
    "developer-knowledge": {
      "httpUrl": "https://developerknowledge.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "$GOOGLE_DK_API_KEY"
      }
    }
  }
}
