{
  "mcpServers": {
    "dart": { "command": "dart", "args": ["mcp-server", "--enable=run_tests,dart_format,dart_fix,launch_app,list_devices,list_running_apps,get_app_logs,stop_app"] },
    "figma": { "serverUrl": "https://mcp.figma.com/mcp" },
    "stitch": {
      "serverUrl": "https://stitch.googleapis.com/mcp",
      "headers": { "X-Goog-Api-Key": "${STITCH_API_KEY}" }
    }
  }
}
