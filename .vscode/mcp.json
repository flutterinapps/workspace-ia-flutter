{
  "servers": {
    "dart": {
      "type": "stdio",
      "command": "dart",
      "args": [
        "mcp-server",
        "--enable=run_tests,dart_format,dart_fix,launch_app,list_devices,list_running_apps,get_app_logs,stop_app"
      ]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "stitch": {
      "type": "http",
      "url": "https://stitch.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${env:STITCH_API_KEY}"
      }
    },
    "marionette": {
      "type": "stdio",
      "command": "dart",
      "args": [
        "pub",
        "global",
        "run",
        "marionette_mcp"
      ]
    },
    "flutter-radar": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "-q",
        "tool/flutter_radar/radar.py",
        "serve"
      ]
    },
    "developer-knowledge": {
      "type": "http",
      "url": "https://developerknowledge.googleapis.com/mcp",
      "headers": {
        "X-Goog-Api-Key": "${env:GOOGLE_DK_API_KEY}"
      }
    }
  }
}
